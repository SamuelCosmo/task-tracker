# Copy to .env for local development (pnpm dev outside Docker).
# Inside docker compose DATABASE_URL is set by docker-compose.yaml instead.

# The compose `db` service, reached from the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasktracker

# Due dates are calendar days; keep this in step with the root .env so the API
# and the containers agree on what "today" is.
TZ=America/Los_Angeles
