# Copy to .env — docker compose reads it automatically.

# IANA timezone for the backend and frontend containers. Due dates are calendar
# days, and "overdue" / "today" must be computed in the user's zone, not the
# container's default of UTC. Find yours with:
#   node -e "console.log(Intl.DateTimeFormat().resolvedOptions().timeZone)"
TZ=America/Los_Angeles
